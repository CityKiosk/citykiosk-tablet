# ─────────────────────────────────────────────────────────
# Souvenirs Berlin — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git — it's gitignored.
# ─────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<project>/settings/api
# NEXT_PUBLIC_* vars are exposed to the browser bundle — safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. NEVER expose to browser, NEVER use NEXT_PUBLIC_ prefix.
# NOT used by the deployed app: all src/ Supabase clients use the anon key + RLS.
# Only the manual dev/ops scripts in scripts/ read this (bulk upload, seed, storage wipe).
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Local Dev (optional) ────────────────────────
# Only needed if using `npx supabase start` for local development.
# Leave blank to use cloud Supabase directly.
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Sentry (error monitoring — required for production) ──
# Get these from: https://sentry.io/settings/projects/<project>/keys/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload (optional — only needed for Sentry source maps)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Application ──────────────────────────────────────────
# Public URL of the deployed app (used for OG images, email links, CSRF).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
